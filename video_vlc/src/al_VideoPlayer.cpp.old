#include "al_ext/video/al_VideoPlayer.hpp"

namespace al {

VideoPlayer::VideoPlayer() {
    
    putenv("VLC_PLUGIN_PATH=/Applications/VLC.app/Contents/MacOS/plugins");
    putenv("VLC_VERBOSE=3");
    if (!setupVLC()) {
        std::cerr << "Failed to initialize VLC" << std::endl;
    }
}

VideoPlayer::~VideoPlayer() {
    cleanup();
}

bool VideoPlayer::setupVLC() {
    if (mVLC) {
        return true; // Already initialized
    }
    // Create VLC instance
    const char* args[] = {
        "-vv",
        "--no-audio", // Skip audio decoding
        "--no-xlib", // Skip X11 dependency
        //"--plugin-path=/Applications/VLC.app/Contents/MacOS/plugins",
    };
    mVLC = libvlc_new(3, args);
    return mVLC != nullptr;
}

void VideoPlayer::cleanup() {
    if (mMediaPlayer) {
        libvlc_media_player_release(mMediaPlayer);
        mMediaPlayer = nullptr;
    }
    if (mMedia) {
        libvlc_media_release(mMedia);
        mMedia = nullptr;
    }
    if (mVLC) {
        libvlc_release(mVLC);
        mVLC = nullptr;
    }
    mIsLoaded = false;
    mIsPlaying = false;
}

bool VideoPlayer::open(const std::string& filename) {
    //cleanup();
    mWidth = 1920;
    mHeight = 1088;
    size_t size = mWidth * mHeight * 4;
    mPixelBuffer.resize(size);
    mTexture.create2D(mWidth, mHeight, Texture::RGBA8, Texture::RGBA, Texture::UBYTE);
    
    // Create media
    mMedia = libvlc_media_new_path(mVLC, filename.c_str());
    if (!mMedia) return false;
    
    // Create media player
    mMediaPlayer = libvlc_media_player_new_from_media(mMedia);
    if (!mMediaPlayer) return false;
    
    // Set up video callbacks
    libvlc_video_set_callbacks(mMediaPlayer, 
                              lock, unlock, display,
                              this);

    // Set format callbacks to get dimensions
    // libvlc_video_set_format_callbacks(mMediaPlayer,
